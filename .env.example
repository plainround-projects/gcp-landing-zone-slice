# Copy to .env (git-ignored). Only the cloud scripts under scripts/ read these.
ORG_ID=123456789012                       # gcloud organizations list. A free Cloud Identity domain gives you an organization.
BILLING_ACCOUNT=AAAAAA-BBBBBB-CCCCCC      # gcloud billing accounts list
NAME_SUFFIX=ab12cd                        # 3-6 lowercase letters or digits; makes project ids and the bucket name unique
OPERATOR_MEMBER=user:operator@example-lab.org   # who runs the proofs (your Cloud Identity user)
OUTSIDE_BUCKET=                           # a bucket in a project OUTSIDE the organization, for the copy attack (step 5)
ACCESS_POLICY_ID=                         # leave empty unless the organization already has an access policy (gcloud access-context-manager policies list --organization=$ORG_ID)
